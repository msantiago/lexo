# Secret d’au moins 32 caractères : openssl rand -base64 32
BETTER_AUTH_SECRET=

# URL publique de l’app (dev : http://localhost:5173)
BETTER_AUTH_URL=http://localhost:5173

# Origines supplémentaires, séparées par des virgules (IP LAN, domaine de prod…)
# AUTH_TRUSTED_ORIGINS=http://192.168.1.22:5173,https://lexo.example.com

# Google (console.cloud.google.com)
# Redirect URI : {BETTER_AUTH_URL}/api/auth/callback/google
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Apple (nécessite HTTPS, pas localhost)
# Redirect URI : {BETTER_AUTH_URL}/api/auth/callback/apple
# APPLE_CLIENT_ID=
# APPLE_TEAM_ID=
# APPLE_KEY_ID=
# APPLE_PRIVATE_KEY=

# Facebook (developers.facebook.com)
# Redirect URI : {BETTER_AUTH_URL}/api/auth/callback/facebook
# FACEBOOK_CLIENT_ID=
# FACEBOOK_CLIENT_SECRET=

# Microsoft (entra.microsoft.com) — comptes personnels
# Redirect URI : {BETTER_AUTH_URL}/api/auth/callback/microsoft
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=

# GitHub (github.com/settings/developers)
# Redirect URI : {BETTER_AUTH_URL}/api/auth/callback/github
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# Discord (discord.com/developers/applications)
# Redirect URI : {BETTER_AUTH_URL}/api/auth/callback/discord
# DISCORD_CLIENT_ID=
# DISCORD_CLIENT_SECRET=

# Admins (comptes Lexo connectés) : fermer un salon, etc.
# E-mails séparés par des virgules, et/ou un fichier data/admins.txt
# (une adresse ou un identifiant par ligne, lignes # ignorées).
# LEXO_ADMIN_EMAILS=toi@example.com
# LEXO_ADMIN_IDS=

# Alertes perso à la création d’un salon (solo ou collectif ; Telegram = vraies notifs iPhone).
# 1. @BotFather → /newbot → LEXO_TELEGRAM_BOT_TOKEN
# 2. Envoie /start au bot, puis :
#    curl https://api.telegram.org/bot<token>/getUpdates
#    → LEXO_TELEGRAM_CHAT_ID (champ "chat":{"id": …})
# LEXO_TELEGRAM_BOT_TOKEN=
# LEXO_TELEGRAM_CHAT_ID=

# ntfy (optionnel, souvent sans bannière sur iOS)
# LEXO_ALERT_URL=https://ntfy.sh/lexo-<ton-topic>
# LEXO_ALERT_TOKEN=
